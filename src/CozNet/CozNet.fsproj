<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <Title>CozNet</Title>
    <Description>Experimental causal profiling for serial .NET CPU workloads.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="DelayLedger.fs" />
    <Compile Include="SampleCredits.fs" />
    <Compile Include="NominalSampleCredits.fs" />
    <Compile Include="SignalService.fs" />
    <Compile Include="SignalAccounting.fs" />
    <Compile Include="CooperativeRuntime.fs" />
    <Compile Include="TargetLocalReplay.fs" />
    <Compile Include="TargetLocalLinux.fs" />
    <Compile Include="TargetLocalProfiler.fs" />
    <Compile Include="TargetCausalProfile.fs" />
    <Compile Include="TargetDiscovery.fs" />
    <Compile Include="TargetDiscoveryWorkflow.fs" />
    <Compile Include="TargetLineAttribution.fs" />
    <Compile Include="Experiment.fs" />
    <InternalsVisibleTo Include="CozNet.Tests" />
    <InternalsVisibleTo Include="CozNet.Instrumentation" />
    <InternalsVisibleTo Include="CozNet.LinuxPerf" />
    <InternalsVisibleTo Include="CozNet.TargetLocal" />
  </ItemGroup>
</Project>
